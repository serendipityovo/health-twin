# ============================================================
# 康孪生 HealthTwin 模型配置
# 复制本文件为 .env 后按需修改，或在应用「模型设置」页图形化配置
# ============================================================

# 模型接入方式：online（在线 API） / ollama（离线本地模型）
LLM_PROVIDER=online

# ---- 在线：任意 OpenAI 兼容接口（示例：智谱 GLM，glm-4-flash 有免费额度） ----
ONLINE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ONLINE_MODEL=glm-4-flash
ONLINE_API_KEY=your_api_key_here

# ---- 离线：Ollama 本地模型（先 ollama pull qwen2.5:7b） ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- 向量检索（可选）：配置后启用 FAISS 语义检索，留空自动用 BM25 关键词检索 ----
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# ---- 生成参数（可选） ----
TEMPERATURE=0.7
MAX_TOKENS=2048
RETRIEVER_TOP_K=4
