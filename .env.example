# ============================================================
# 康孪生 HealthTwin 后台配置（部署者在部署时填写一次即可，
# 普通用户界面不会出现任何模型 / 密钥选项）
# ============================================================

# ---- 必填：DeepSeek API Key（https://platform.deepseek.com 创建） ----
DEEPSEEK_API_KEY=

# ---- 开发者模式：1 = 导航显示「🛠 开发者选项」页（自定义模型等），0 = 普通模式 ----
DEV_MODE=0

# ============================================================
# 以下为开发者高级选项，普通部署无需修改
# ============================================================
# 覆盖模型接口（默认 DeepSeek 官方，deepseek-chat 自动指向最新 V3 系列）
# ONLINE_BASE_URL=https://api.deepseek.com/v1
# ONLINE_MODEL=deepseek-chat

# 切换为 Ollama 离线模式（LLM_PROVIDER=ollama）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# 生成参数
# TEMPERATURE=0.7
# MAX_TOKENS=2048
# RETRIEVER_TOP_K=4
